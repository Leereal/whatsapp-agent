{
  "name": "whatsapp-agent",
  "description": "CareerCVPro WhatsApp assistant: Chrome extension for WhatsApp Web",
  "private": true,
  "version": "0.3.3",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "build:dev": "wxt build --mode development",
    "zip": "wxt zip",
